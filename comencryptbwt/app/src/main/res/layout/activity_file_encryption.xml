<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título principal -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FILE ENCRYPTION/DECRYPTION"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- RadioGroup para “Encrypt File” / “Decrypt File” -->
        <RadioGroup
            android:id="@+id/actionRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioEncrypt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Encrypt File"
                android:checked="true"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/radioDecrypt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decrypt File"
                android:textColor="@android:color/white"
                android:layout_marginStart="32dp"/>
        </RadioGroup>

        <!-- Botón: Pick File -->
        <Button
            android:id="@+id/buttonPickFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHOOSE FILE"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:backgroundTint="@color/purple_500"
            android:textColor="@android:color/white"/>

        <!-- Texto: ruta del archivo elegido -->
        <TextView
            android:id="@+id/textSelectedFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No file selected"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />

        <!-- Título “Cipher:” -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cipher:"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <!-- Spinner ciphers -->
        <Spinner
            android:id="@+id/spinnerCipher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:popupBackground="#2B2B2B"
            android:layout_marginBottom="16dp"/>

        <!-- Botón: Pick Key -->
        <Button
            android:id="@+id/buttonPickKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHOOSE KEY"
            android:textStyle="bold"
            android:backgroundTint="@color/purple_500"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <!-- Texto con la key elegida -->
        <TextView
            android:id="@+id/textChosenKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(No key chosen)"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp"/>

        <!-- Carpeta de salida: OPCIONAL. Si no se elige, tras EXECUTE se abre el
             diálogo "Guardar como" del sistema (cualquier ubicación). -->
        <Button
            android:id="@+id/buttonPickOutputDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHOOSE OUTPUT FOLDER (OPTIONAL)"
            android:textStyle="bold"
            android:backgroundTint="@color/purple_500"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"
            android:enabled="true"/>

        <TextView
            android:id="@+id/textOutputDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No folder selected. After EXECUTE you will choose where to save the file."
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonClearOutputDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESET FOLDER (ASK EVERY TIME)"
            android:textStyle="bold"
            android:backgroundTint="@color/purple_700"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>

        <!-- Botón: EXECUTE (Encrypt o Decrypt) -->
        <Button
            android:id="@+id/buttonProcess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXECUTE"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_700"
            android:layout_marginTop="16dp" />

        <!-- Progreso -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/textProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:visibility="gone"/>

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CANCEL"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            android:visibility="gone"/>

        <!-- Texto de resultado -->
        <TextView
            android:id="@+id/textResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:layout_marginTop="16dp"
            android:text="Result output..."
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
